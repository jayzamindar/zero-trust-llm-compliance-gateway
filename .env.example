# ==============================================================================
# Zero-Trust GenAI Compliance Gateway - Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Distributed Redis Storage
REDIS_URL=redis://redis:6379/0
TOKEN_VAULT_TTL_SECONDS=3600
KEY_PREFIX=compliance:vault

# Default Rate Limiting & Quotas (per project)
DEFAULT_MAX_DAILY_REQUESTS=10000
DEFAULT_MAX_DAILY_TOKENS=1000000

